# Copy to .env.local for development. In production, set these in your host's environment settings.
# Never commit real values. Each channel below switches on only when all of its variables are set;
# an enquiry succeeds when at least one channel stores it. With neither set, local development prints
# enquiries to the server console, and production refuses them (so a lead is never silently lost).

# Google Sheets (service account with Editor access on the target Sheet)
# 1. Google Cloud console: create a service account, enable the Google Sheets API, add a JSON key.
# 2. Share the Sheet with the service account's email as Editor.
# CLIENT_EMAIL / PRIVATE_KEY: "client_email" and "private_key" from the JSON key. Keep the key in
# double quotes on one line with its \n sequences, e.g. "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# SHEET_ID: the long id in the Sheet URL, docs.google.com/spreadsheets/d/<SHEET_ID>/edit
# TAB_NAME: the tab to append to, e.g. Enquiries. Headings are written to row 1 if it is empty.
GOOGLE_SHEETS_CLIENT_EMAIL=""
GOOGLE_SHEETS_PRIVATE_KEY=""
GOOGLE_SHEET_ID=""
GOOGLE_SHEET_TAB_NAME=""

# Google Drive (Careers CV uploads) - uses the same service account as Google Sheets.
# The folder MUST be inside a Shared Drive (service accounts have no storage of their own, so
# uploads to a normal "My Drive" folder are refused). Add GOOGLE_SHEETS_CLIENT_EMAIL to that
# Shared Drive as a "Contributor", and enable the Google Drive API in the same Cloud project.
# Folder ID: the part after /folders/ in the folder URL,
# e.g. drive.google.com/drive/folders/<GOOGLE_DRIVE_CV_FOLDER_ID>
GOOGLE_DRIVE_CV_FOLDER_ID=""

# Resend
# RESEND_API_KEY: from resend.com/api-keys (starts with "re_"). Server-only; never prefix with NEXT_PUBLIC_.
# FROM_EMAIL: sender on a domain verified in Resend, e.g. Arbrit Safety <enquiries@yourdomain.com>
# ADMIN_EMAIL: one address, or several separated by commas: admin@yourdomain.com,training@yourdomain.com
RESEND_API_KEY=""
FROM_EMAIL=""
ADMIN_EMAIL=""

# Site address (no trailing slash): canonical links, sitemap, robots.txt and the link in emails.
# Local development: keep http://localhost:3000.
# Vercel: leave it UNSET. The site then uses Vercel's production address automatically (the
# *.vercel.app URL now, the custom domain once it is added) and stays out of search results
# until it is on a real domain. See lib/site.ts.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
